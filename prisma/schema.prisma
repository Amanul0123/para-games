generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model TeamUser {
  id                String    @id @default(uuid())
  email             String    @unique
  password          String
  name              String
  npc               String
  phone             String?
  designation       String?
  mustResetPassword Boolean   @default(true)
  createdAt         DateTime  @default(now())
  athletes          Athlete[]
  teamDays          TeamDay[]
  injuries          Injury[]
  illnesses         Illness[]
}

model Athlete {
  id              String   @id @default(uuid())
  teamUserId      String
  teamUser        TeamUser @relation(fields: [teamUserId], references: [id])
  name            String
  accreditationNo String
  sport           String?
  archived        Boolean  @default(false)
  createdAt       DateTime @default(now())

  teamDayEntries TeamDayAthlete[]
  injuries       Injury[]
  illnesses      Illness[]

  @@unique([teamUserId, accreditationNo])
}

model TeamDay {
  id         String   @id @default(uuid())
  teamUserId String
  teamUser   TeamUser @relation(fields: [teamUserId], references: [id])
  date       DateTime @db.Date
  createdAt  DateTime @default(now())

  athletes TeamDayAthlete[]

  @@unique([teamUserId, date])
}

model TeamDayAthlete {
  id        String  @id @default(uuid())
  teamDayId String
  teamDay   TeamDay @relation(fields: [teamDayId], references: [id])
  athleteId String
  athlete   Athlete @relation(fields: [athleteId], references: [id])

  @@unique([teamDayId, athleteId])
}

model Injury {
  id         String   @id @default(uuid())
  teamUserId String
  teamUser   TeamUser @relation(fields: [teamUserId], references: [id])
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id])

  sportEvent    String
  injuryDate    DateTime @db.Date
  bodyPart      String
  injuryType    String
  causeOfInjury String?

  originalDaysLost Int?
  editedDaysLost   Int?
  timeLossStatus   String @default("original") // original | edited
  status           String @default("logged") // logged | under_review | resolved

  createdAt DateTime @default(now())
}

model Illness {
  id         String   @id @default(uuid())
  teamUserId String
  teamUser   TeamUser @relation(fields: [teamUserId], references: [id])
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id])

  sportEvent     String
  occurredOn     DateTime @db.Date
  diagnosis      String
  affectedSystem String?
  mainSymptoms   String?
  causeOfIllness String?

  originalDaysLost Int?
  editedDaysLost   Int?
  timeLossStatus   String @default("original") // original | edited
  status           String @default("logged") // logged | under_review | resolved

  createdAt DateTime @default(now())
}

model RecordNote {
  id         String   @id @default(uuid())
  recordType String // "injury" | "illness"
  recordId   String
  author     String
  message    String
  createdAt  DateTime @default(now())
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model EventSettings {
  id               String   @id @default("singleton")
  eventName        String   @default("Aichi Nagoya 2026 Asian Para Games")
  organizationName String   @default("Asian Paralympic Committee")
  startDate        DateTime? @db.Date
  endDate          DateTime? @db.Date
  logoUrl          String?
  updatedAt        DateTime @updatedAt
}
